{
    "name": "irrigationsystem",
    "displayName": "Irrigation System",
    "type": "module",
    "version": "0.0.9",
    "description": "HomeKit irrigation system using HAP-NodeJS library",
    "author": "n0rt0nthec4t",
    "license": "Apache-2.0",
    "homepage": "https://github.com/n0rt0nthec4t/irrigationsystem/#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/n0rt0nthec4t/irrigationsystem.git"
    },
    "bugs": {
        "url": "https://github.com/n0rt0nthec4t/irrigationsystem/issues"
    },
    "funding": "https://github.com/n0rt0nthec4t/irrigationsystem?sponsor=1",
    "keywords": [
        "homekit",
        "irrigation",
        "watering"
    ],
    "main": "dist/index.js",
    "engines": {
        "node": "^22 || ^24",
        "hap-nodejs": "^2.2.3"
    },
    "files": [
        "LICENSE",
        "dist/**/*",
        "usonic_measure.c",
        "README.md",
        "CHANGELOG.md"
    ],
    "scripts": {
        "clean": "node scripts/clean.js",
        "format": "prettier --write \"src/*.{js,mjs}\" \"tests/**/*.{js,mjs}\" \"scripts/**/*.js\" && eslint --config eslint.config.js --fix \"src/*.{js,mjs}\" \"tests/**/*.{js,mjs}\" \"scripts/**/*.js\"",
        "lint": "eslint --config eslint.config.js \"src/**/*.{js,mjs}\" \"tests/**/*.{js,mjs}\" \"scripts/**/*.js\" --max-warnings=20",
        "test": "npm run build && node --test tests/*.test.mjs src/HomeKitDevice/HomeKitDevice.test.js src/HomeKitHistory/HomeKitHistory.test.js src/HomeKitUI/HomeKitUI.test.js",
        "test:coverage": "npm run build && node --test --experimental-test-coverage tests/*.test.mjs src/HomeKitDevice/HomeKitDevice.test.js src/HomeKitHistory/HomeKitHistory.test.js src/HomeKitUI/HomeKitUI.test.js",
        "check": "npm run lint && npm test && npm run build",
        "build": "npm run clean && node scripts/build.js",
        "prepublishOnly": "npm run format && npm run lint && npm test && npm run build"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.6.5",
        "@typescript-eslint/parser": "^8.72.0",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "prettier-eslint": "^17.1.2"
    },
    "dependencies": {
        "@homebridge/hap-nodejs": "^2.2.3",
        "ansi_up": "^6.0.6",
        "chalk": "^6.0.1",
        "express": "^5.3.0",
        "qrcode": "^1.5.4",
        "rpio": "^2.4.2"
    }
}
